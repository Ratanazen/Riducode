{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ridu",
  "scopeName": "source.ridu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ridu",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ridu",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ridu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ridu",
              "match": "\\\\(n|t|r|\\\\|\"|0)"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.ridu",
          "match": "\\b(val|var)\\b"
        },
        {
          "name": "keyword.declaration.fun.ridu",
          "match": "\\b(fun)\\b"
        },
        {
          "name": "keyword.control.ridu",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.other.ridu",
          "match": "\\b(package|data|class|interface|import)\\b"
        },
        {
          "name": "support.function.builtin.ridu",
          "match": "\\b(println|print)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ridu",
          "match": "\\b(Int|Float|String|Bool|Unit|Any)\\b"
        },
        {
          "name": "entity.name.type.ridu",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ridu",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.ridu",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ridu",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.ridu",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.declaration.fun.ridu"
            },
            "2": {
              "name": "entity.name.function.ridu"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.ridu"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ridu",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.ridu",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.ridu",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ridu",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.ridu",
          "match": ",|:|;"
        },
        {
          "name": "punctuation.section.block.ridu",
          "match": "\\{|\\}"
        },
        {
          "name": "punctuation.section.group.ridu",
          "match": "\\(|\\)"
        }
      ]
    }
  }
}
